{
  "compilerOptions": {
    /*
     * Typecheck only — tsc never writes output here.
     *
     * - The package is built by a bundler, which emits the JS and `.d.ts`.
     *
     * - `declaration` is still on because `isolatedDeclarations` requires it.
     */
    "declaration": true,
    "noEmit": true,

    /*
     * Every export must carry types a declaration emitter can read without
     * running the checker.
     *
     * - Forces explicit return types on exported functions — intended for a
     *   published API, whose `.d.ts` should never depend on inference.
     */
    "isolatedDeclarations": true,

    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,

    /*
     * `import type` is required for type-only imports, and imports are emitted
     * exactly as written — what a bundler and a published ESM package expect.
     */
    "verbatimModuleSyntax": true,

    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",

    /*
     * TypeScript 6 defaults `types` to none, so Node's are opted in by name.
     *
     * - `@types/node` is pinned to the `engines.node` floor (22), so the
     *   typecheck rejects an API a supported Node doesn't have.
     *
     * - The public API must never reference a Node type.
     */
    "types": ["node"],

    "skipLibCheck": true
  },
  "include": [
    /*
     * The repo's own config files.
     *
     * - A glob rather than a list, so a new one is covered the day it is
     *   written.
     *
     * - They live in this root because an editor and ESLint's project service
     *   both resolve a file by walking up to the nearest config named exactly
     *   `tsconfig.json`; anywhere else they typecheck in CI while showing
     *   phantom errors in the editor.
     */
    "*.config.ts",

    "scripts",
    "src",
    "test"
  ]
}
