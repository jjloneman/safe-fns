{
  "cases": [
    {
      "args": [
        {
          "a": [
            1,
            {
              "b": "x"
            }
          ]
        }
      ],
      "expected": {
        "a": [
          1,
          {
            "b": "x"
          }
        ]
      }
    },
    {
      "args": ["text"],
      "expected": "text"
    },
    {
      "args": [42],
      "expected": 42
    },
    {
      "args": [
        {
          "$number": "-0"
        }
      ],
      "expected": {
        "$number": "-0"
      }
    },
    {
      "args": [
        {
          "$number": "NaN"
        }
      ],
      "expected": {
        "$number": "NaN"
      }
    },
    {
      "args": [
        {
          "$bigint": "12"
        }
      ],
      "expected": {
        "$bigint": "12"
      }
    },
    {
      "args": [null],
      "expected": null
    },
    {
      "args": [
        {
          "$undefined": true
        }
      ],
      "expected": {
        "$undefined": true
      }
    },
    {
      "args": [
        {
          "$js": "a Date"
        }
      ],
      "expected": {
        "$repr": "[object Date]"
      }
    },
    {
      "args": [
        {
          "$js": "a Map with an entry"
        }
      ],
      "expected": {
        "$repr": "[object Map]"
      }
    },
    {
      "args": [
        {
          "$js": "a Set with an entry"
        }
      ],
      "expected": {
        "$repr": "[object Set]"
      }
    },
    {
      "args": [
        {
          "$js": "a RegExp"
        }
      ],
      "expected": {
        "$repr": "[object RegExp]"
      }
    },
    {
      "args": [
        {
          "$js": "a Uint8Array"
        }
      ],
      "expected": {
        "$repr": "[object Uint8Array]"
      }
    },
    {
      "args": [
        {
          "$js": "an Error"
        }
      ],
      "expected": {
        "$repr": "[object Error]"
      }
    },
    {
      "args": [
        {
          "$js": "a class instance"
        }
      ],
      "expected": {
        "x": 1
      }
    },
    {
      "args": [
        {
          "$js": "an object with a getter"
        }
      ],
      "expected": {
        "a": 1
      }
    },
    {
      "args": [
        {
          "$js": "an object with a cycle"
        }
      ],
      "expected": {
        "name": "a",
        "self": {
          "$repr": "Symbol(cycle)"
        }
      }
    },
    {
      "args": [
        {
          "$js": "an object with a shared reference"
        }
      ],
      "expected": {
        "a": {
          "x": 1
        },
        "b": {
          "$repr": "Symbol(repeat)"
        }
      }
    },
    {
      "args": [
        {
          "$js": "a function"
        }
      ],
      "expected": {
        "$undefined": true
      }
    },
    {
      "args": [
        {
          "$js": "an object holding a function"
        }
      ],
      "expected": {
        "$undefined": true
      }
    },
    {
      "args": [
        {
          "$js": "a symbol"
        }
      ],
      "expected": {
        "$undefined": true
      }
    },
    {
      "args": [
        {
          "$js": "an object with a throwing getter"
        }
      ],
      "expected": {
        "$undefined": true
      }
    },
    {
      "args": [
        {
          "$js": "a revoked proxy"
        }
      ],
      "expected": {
        "$undefined": true
      }
    },
    {
      "args": [
        {
          "$js": "a proxy whose ownKeys trap throws"
        }
      ],
      "expected": {
        "$undefined": true
      }
    }
  ],
  "function": "safeStructuredClone"
}
