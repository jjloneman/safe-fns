{
  "cases": [
    {
      "args": [
        {
          "a": 1
        },
        "a"
      ],
      "expected": true
    },
    {
      "args": [
        {
          "a": 1
        },
        "b"
      ],
      "expected": false
    },
    {
      "args": [
        {
          "a": 1
        },
        "toString"
      ],
      "expected": false
    },
    {
      "args": [
        {
          "a": null
        },
        "a"
      ],
      "expected": true
    },
    {
      "args": [
        {
          "a.b": 1
        },
        "a.b"
      ],
      "expected": true
    },
    {
      "args": [
        {
          "a": {
            "b": 1
          }
        },
        "a.b"
      ],
      "expected": false
    },
    {
      "args": [
        {
          "$js": "a null-prototype object with a"
        },
        "a"
      ],
      "expected": true
    },
    {
      "args": [["x"], "0"],
      "expected": true
    },
    {
      "args": [["x"], "length"],
      "expected": true
    },
    {
      "args": ["abc", "0"],
      "expected": false
    },
    {
      "args": ["abc", "length"],
      "expected": false
    },
    {
      "args": [42, "toFixed"],
      "expected": false
    },
    {
      "args": [null, "a"],
      "expected": false
    },
    {
      "args": [
        {
          "$undefined": true
        },
        "a"
      ],
      "expected": false
    },
    {
      "args": [
        {
          "$js": "a revoked proxy"
        },
        "a"
      ],
      "expected": false
    },
    {
      "args": [
        {
          "$js": "a proxy of a plain object"
        },
        "a"
      ],
      "expected": true
    },
    {
      "args": [
        {
          "$js": "a cross-realm object"
        },
        "a"
      ],
      "expected": true
    }
  ],
  "function": "safeObjectHasOwn"
}
