{
  "compilerOptions": {
    /*
     * The adapters run only on the pinned Node image, which has
     * `Uint8Array.fromBase64` and `toBase64`, and `Error.isError`; the
     * package itself stays on ES2022.
     */
    "lib": ["ES2022", "esnext.error", "esnext.typedarrays"]
  },
  "exclude": [
    // AssemblyScript, checked by its own nested config against its own types.
    "adapters/assemblyscript"
  ],
  /*
   * `research/` is its own installed package, so its TypeScript resolves
   * imports from `research/node_modules` through this nested config.
   *
   * - Named exactly `tsconfig.json`, so an editor and ESLint's project service
   *   find it by walking up from an adapter, as they find the root's.
   *
   * - The root config doesn't include `research/`; this one checks it, in
   *   `research-check.yml`, after `pnpm --dir research install`.
   */
  "extends": "../tsconfig.json",
  "include": [
    // The Node adapter, plus whatever it imports from `scripts/` and `test/`.
    "adapters"
  ]
}
